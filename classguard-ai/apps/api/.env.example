# Local settings only. Copy this file to .env and provide your own values.
DATABASE_URL=sqlite:///./classguard.db
# Set to classguard for the private PostgreSQL schema; ignored for SQLite.
DATABASE_SCHEMA=
CORS_ORIGINS=["http://localhost:3000"]

# ES256/RS256 JWT verification plus fresh current-user/confirmed-email checks.
# Use the same public sb_publishable_ key as the frontend, never a service-role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
